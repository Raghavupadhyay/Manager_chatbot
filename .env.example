# ── LLM (optional — keyword fallback parser used without it) ────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=20
LLM_RETRIES=2
LLM_STREAM=true

# ── Guardrails ──────────────────────────────────────────────────────────────
GUARD_LLM_JUDGE=true
GOAL_MAX_CHARS=600

# ── LangSmith observability + evals (optional) ───────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ops-copilot

# ── Server / storage ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
# Optional API-key auth — if set, all workflow endpoints require X-API-Key
AUTH_API_KEY=

# ── Workflow limits ──────────────────────────────────────────────────────────
PLANNING_TIMEOUT_S=120
EXECUTION_TIMEOUT_S=60
LAUNCH_RATE_LIMIT_PER_MIN=10
SSE_HEARTBEAT_S=30

# ── Calendar booking ─────────────────────────────────────────────────────────
BOOKING_MAX_DATE_SHIFTS=2
